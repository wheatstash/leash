# Copy to server/.env and fill in. Never commit real values.

# PayPal sandbox app credentials (developer.paypal.com > Apps & Credentials > Sandbox).
# Leave as placeholders to run in mock mode (no PayPal calls are made).
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
# Force mock mode even when credentials are set.
PAYPAL_MOCK=false

# Anthropic API key (console.anthropic.com). Required: the agent and the policy translator use Claude.
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium

PORT=8787
APPROVER_NAME=Business owner

# Demo sign-in. The defaults are public on purpose (shown to judges on the sign-in screen).
DEMO_EMAIL=judge@example.com
DEMO_PASSWORD=leash-demo-2026
DEMO_SHOW_CREDENTIALS=true
# Signs session tokens. Set a long random value in production so sessions survive restarts.
AUTH_SECRET=
# Seeded sandbox payments as JSON (the contents of server/data/demo-orders.json). Only needed on
# hosts that don't have that file, e.g. Render.
DEMO_CAPTURES=

# Agent budget: Claude-backed runs (chat message, email handled, rule translated) per visitor per
# hour, and across all visitors per UTC day.
AGENT_RUNS_PER_HOUR=30
AGENT_RUNS_PER_DAY=600

# Optional: a PayPal sandbox personal (buyer) account to show on the in-app checkout, so judges can
# pay for the demo orders as the customer. Sandbox only, never a real PayPal login.
SANDBOX_BUYER_EMAIL=
SANDBOX_BUYER_PASSWORD=
